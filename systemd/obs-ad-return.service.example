# Copy to ~/.config/systemd/user/obs-ad-return.service, replace /path/to/rl-broadcast-kit with the real
# folder, then: systemctl --user daemon-reload && systemctl --user enable --now obs-ad-return
[Unit]
Description=Switch OBS scenes back when the ad and intro videos end

[Service]
WorkingDirectory=/path/to/rl-broadcast-kit
ExecStart=/usr/bin/python3 -I /path/to/rl-broadcast-kit/tools/obs_ad_return.py
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
