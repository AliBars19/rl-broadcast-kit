# Copy to ~/.config/systemd/user/phone-cam.service, replace /path/to/rl-broadcast-kit with the real
# folder, then: systemctl --user daemon-reload && systemctl --user enable --now phone-cam
# Add Environment=PHONECAM_OUT_ROOT=/your/folder (and any other PHONECAM_* setting) under [Service] if needed.
[Unit]
Description=Phone camera feed for OBS with phone-side recording

[Service]
ExecStart=/path/to/rl-broadcast-kit/tools/phonecam/phone-cam --foreground
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
